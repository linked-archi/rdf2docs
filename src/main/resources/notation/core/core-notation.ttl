@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix vann:     <http://purl.org/vocab/vann/> .
@prefix cc:       <http://creativecommons.org/ns#> .

@prefix arch:     <https://meta.linked.archi/core#> .
@prefix arch-vis: <https://meta.linked.archi/core-vis#> .
@prefix :         <https://meta.linked.archi/core-notation#> .

<https://meta.linked.archi/core-notation#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/core-notation#" ;
    vann:preferredNamespacePrefix "archnot" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi Core Visual Notation"@en ;
    dcterms:description           '''The visual notation of the core's own relationship types, which relate any
two model concepts that no loaded language relates (DD-40). No metamodel manifest names it: it applies
whatever the language, so a tool loads it with the core, as it loads core-shapes, and consults its notation
set after the default sets of every loaded metamodel — the last fallback layer of the lookup in the Visual
Notation Guide. A language's own descriptor for a core class therefore wins over this one.

It describes each of them, so that every tool draws them alike whatever its own defaults:
arch:Association as a solid line with nothing at either end, as it has no direction; arch:HasPart and
arch:Refines as a solid line with an open arrowhead at the target — the part, the concept refined; and
arch:DependsOn as a dashed line with an open arrowhead at the concept depended on, so that it is not taken
for either (DD-40). Nesting may draw arch:HasPart and arch:Refines instead of a line: the part inside the
whole (arch-vis:nestedEnd arch-vis:TargetEnd), and the refining concept inside the refined one
(arch-vis:SourceEnd) — a view nested in the box of the element it details. An editor that nests one concept
in another can then offer to record either.'''@en ;
    dcterms:created               "2026-11-21"^^xsd:date ;
    dcterms:modified              "2026-11-22"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/core-notation/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source                <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    prov:wasDerivedFrom           <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    rdfs:seeAlso                  <https://meta.linked.archi/docs/guide/visual-notation-guide/> ;
.


#################################################################
# Notation Set
#################################################################

:CoreNotation
    a               arch-vis:NotationSet ;
    skos:prefLabel  "Core Notation"@en ;
    skos:definition '''Notation set of the core's own relationship types: arch:Association a plain solid
line, arch:HasPart and arch:Refines a solid line with an open arrowhead at the target, arch:DependsOn a
dashed one. Nesting may draw arch:HasPart, the part inside the whole, and arch:Refines, the refining
concept inside.'''@en ;
    skos:scopeNote  '''No metamodel names this set with arch:notationSet, and no presentation context
picks it with arch:usesNotationSet: it is never the set a palette is styled by. A renderer consults it
after the default sets of every loaded metamodel, for a class that none of them describes — a descriptor a
language publishes for a core class comes first. The lines are those DD-40 has a tool draw for a
relationship type with no notation: from its source to its target, with an arrowhead, unless its predicate
is symmetric, as arch:associatedWith is. arch:DependsOn's is dashed besides, so that a dependency is not
read as a part or a refinement (DD-40). Stated here, they do not depend on a tool's defaults.'''@en ;
.


#################################################################
# Relationship Visual Notation
#################################################################

:AssociationNotation
    a                      arch-vis:VisualNotation ;
    skos:prefLabel         "Association notation"@en ;
    skos:definition        '''Solid line with no decoration at either end, for arch:Association. An
association is undirected — its predicate, arch:associatedWith, is symmetric — so neither end carries a
marker. Nesting does not draw it.'''@en ;
    arch-vis:notationFor   arch:Association ;
    arch-vis:inNotationSet :CoreNotation ;
    arch-vis:lineStyle     arch-vis:SolidLine ;
    arch-vis:sourceDecor   arch-vis:NoDecoration ;
    arch-vis:targetDecor   arch-vis:NoDecoration ;
.

:DependsOnNotation
    a                      arch-vis:VisualNotation ;
    skos:prefLabel         "Depends On notation"@en ;
    skos:definition        '''Dashed line with no decoration at the source end and an open arrowhead at
the target end, for arch:DependsOn: from the dependent concept to the one it depends on. Dashed, it is not
taken for arch:HasPart or arch:Refines, which are drawn solid. Nesting does not draw it.'''@en ;
    arch-vis:notationFor   arch:DependsOn ;
    arch-vis:inNotationSet :CoreNotation ;
    arch-vis:lineStyle     arch-vis:DashedLine ;
    arch-vis:sourceDecor   arch-vis:NoDecoration ;
    arch-vis:targetDecor   arch-vis:OpenArrowhead ;
.

:HasPartNotation
    a                      arch-vis:VisualNotation ;
    skos:prefLabel         "Has Part notation"@en ;
    skos:definition        '''Solid line with no decoration at the source end and an open arrowhead at
the target end, for arch:HasPart: from the whole to its part. Nesting may draw it instead of a line, the
target — the part — inside the source, the whole.'''@en ;
    arch-vis:notationFor   arch:HasPart ;
    arch-vis:inNotationSet :CoreNotation ;
    arch-vis:lineStyle     arch-vis:SolidLine ;
    arch-vis:sourceDecor   arch-vis:NoDecoration ;
    arch-vis:targetDecor   arch-vis:OpenArrowhead ;
    arch-vis:nestedEnd     arch-vis:TargetEnd ;
.

:RefinesNotation
    a                      arch-vis:VisualNotation ;
    skos:prefLabel         "Refines notation"@en ;
    skos:definition        '''Solid line with no decoration at the source end and an open arrowhead at
the target end, for arch:Refines: from the more concrete concept to the one it refines. Nesting may draw it
instead of a line, the source — the refining concept — inside the target: a view drawn inside the box of the
element it details refines that element.'''@en ;
    arch-vis:notationFor   arch:Refines ;
    arch-vis:inNotationSet :CoreNotation ;
    arch-vis:lineStyle     arch-vis:SolidLine ;
    arch-vis:sourceDecor   arch-vis:NoDecoration ;
    arch-vis:targetDecor   arch-vis:OpenArrowhead ;
    arch-vis:nestedEnd     arch-vis:SourceEnd ;
.
